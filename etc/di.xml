<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        html.lang guard: Page\Config reset clears elements=[] between requests, wiping the html.lang set
        in the constructor. Without it document.documentElement.lang is "" and Intl.NumberFormat breaks
        (ElasticSuite price slider). This after-plugin re-adds it.
    -->
    <type name="Magento\Framework\View\Page\Config">
        <plugin name="mage_os_worker_mode_html_lang_attribute"
                type="MageOS\WorkerMode\Plugin\View\Page\ConfigPlugin"/>
    </type>

    <!--
        Layout subclass (ResetAfterRequestInterface). The framework Resetter's reflection path silently
        fails on PHP 8.4 lazy-ghost Interceptors (see OPENGENTO_UPSTREAM_CHANGES.md "Change 4"), so state
        that must reset between requests is handled via a real _resetState() here (_xml, _blocks,
        readerContext, ...). Unlike Design/Page\Config/Area this stays a subclass because it ALSO overrides
        isCacheable()/generateElements() (behavioural fix for the checkout-success depersonalize bug), so it
        cannot be a plain LazyGhostReset target. It is the one remaining framework <preference>.
    -->
    <preference for="Magento\Framework\View\Layout"
                type="MageOS\WorkerMode\Model\View\Layout"/>

    <!--
        opengento sets isIsolated=true on Page/Layout result types (a private layout per request), which
        breaks Hyvä's ProductListItem view model (it holds the shared LayoutInterface and calls getBlock()).
        The Resetter already resets Layout state between requests, so isolation is unnecessary.
    -->
    <type name="Magento\Framework\View\Result\Page">
        <arguments>
            <argument name="isIsolated" xsi:type="boolean">false</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Result\Layout">
        <arguments>
            <argument name="isIsolated" xsi:type="boolean">false</argument>
        </arguments>
    </type>

    <!--
        Reset the opengento SessionRegistry (WeakMap of started sessions) between requests so each request
        only closes the sessions it started, not an accumulation from prior requests/areas. (Overriding an
        opengento class is the one <preference> category we keep — see OPENGENTO_UPSTREAM_CHANGES.md.)
    -->
    <preference for="Opengento\Application\App\Session\SessionRegistry"
                type="MageOS\WorkerMode\App\Session\SessionRegistry"/>

    <!--
        Lazily (re)start any session on first access this request. A SessionManager singleton's constructor
        calls start() once per worker; on warm requests it is never called again, so storage stays bound to
        a previous request's $_SESSION. This plugin runs start() before the first magic access (__call),
        explicit getData(), the Customer/Auth entry methods (isLoggedIn/getCustomerId) that read storage
        directly, and the TFA grant methods. Consolidates the former six per-session start() plugins;
        afterGetCustomerId repairs a null customer id from a mid-request reference break.
    -->
    <type name="Magento\Framework\Session\SessionManager">
        <plugin name="mage_os_worker_mode_session_start"
                type="MageOS\WorkerMode\Plugin\Session\SessionStartPlugin"/>
    </type>

    <!--
        FrontendConfig needs a scopeType so _scopeConfig->getValue() uses 'default' scope for cookie
        settings (path, domain, lifetime) — matching the generic Magento\Framework\Session\Config.
    -->
    <type name="MageOS\WorkerMode\Session\FrontendConfig">
        <arguments>
            <argument name="scopeType" xsi:type="const">Magento\Framework\App\Config\ScopeConfigInterface::SCOPE_TYPE_DEFAULT</argument>
        </arguments>
    </type>

    <type name="Opengento\Application\App\Http">
        <!--
            Restore the correct area OM as ObjectManager::getInstance()'s target before the request runs.
            The static $_instance is overwritten by every new OM constructor, so after the first
            webapi_rest/adminhtml bootstrap getInstance() returns the wrong area's OM on later frontend
            requests (wrong asset URLs / robots / body class). (OPENGENTO_UPSTREAM_CHANGES.md "Change 3".)
        -->
        <plugin name="mage_os_worker_mode_om_context"
                type="MageOS\WorkerMode\Plugin\App\ObjectManagerContextPlugin"
                sortOrder="1"/>
        <!--
            LazyGhostReset (ResetAfterRequestInterface): force-initialises each lazy ghost then
            reflection-resets Design (_area/_theme), Page\Config, Area (_loadedParts['design']),
            AdminSessionsManager and admin Widget\Context ButtonList — the no-patch stand-in for the
            framework Resetter fix (OPENGENTO_UPSTREAM_CHANGES.md "Change 4"). beforeLaunch is a no-op that
            just gets the helper instantiated so the Resetter tracks it.
        -->
        <plugin name="mage_os_worker_mode_lazy_ghost_reset"
                type="MageOS\WorkerMode\Model\Reset\LazyGhostReset"/>
    </type>
</config>
