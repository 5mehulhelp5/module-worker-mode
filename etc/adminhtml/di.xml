<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Backstop for admin login when start() failed silently before setUser(): beforeProcessLogin() checks
        session_status() and, if inactive, captures the pending user, calls start() to establish the
        reference, and re-writes the user so it lands in $_SESSION['admin'] before regenerateId() snapshots
        it — otherwise the committed session has no user and the next request bounces to login. (The primary
        Auth/Backend/TFA session start is handled by SessionStartPlugin.)
    -->
    <type name="Magento\Backend\Model\Auth\Session">
        <plugin name="mage_os_worker_mode_admin_auth_session_process_login"
                type="MageOS\WorkerMode\Plugin\Session\AuthSessionProcessLoginPlugin"/>
    </type>

    <!--
        Commit the admin session to Redis before sendResponse() (admin login 302 race): without this,
        session_write_close() only runs in the resetState() finally block, after the redirect. A second
        worker can pick up the follow-up GET before the new session is written and see the admin as logged
        out (login loop). closeSessions() in afterLaunch writes+closes all active sessions first.
        sortOrder=10000 so it runs after every other afterLaunch plugin.
    -->
    <type name="Opengento\Application\App\Http">
        <plugin name="mage_os_worker_mode_admin_session_commit"
                type="MageOS\WorkerMode\Plugin\App\SessionCommitPlugin"
                sortOrder="10000"/>
    </type>
</config>
