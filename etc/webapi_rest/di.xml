<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Inject FrontendConfig as sessionConfig for the REST-area CustomerSession and CheckoutSession so
        initIniOptions() resets session.name to 'PHPSESSID' (undoing 'admin' contamination from a prior
        admin request on the worker). webapi_rest has its own session singletons, separate from frontend.
    -->
    <type name="Magento\Customer\Model\Session">
        <arguments>
            <argument name="sessionConfig" xsi:type="object">MageOS\WorkerMode\Session\FrontendConfig</argument>
        </arguments>
    </type>
    <type name="Magento\Checkout\Model\Session">
        <arguments>
            <argument name="sessionConfig" xsi:type="object">MageOS\WorkerMode\Session\FrontendConfig</argument>
        </arguments>
    </type>

    <type name="Opengento\Application\App\Http">
        <!--
            Render pending REST exceptions instead of an empty 200: App\Http::handleHttpResult copies
            getContent() before sendResponse() runs on a REST response carrying setException(), so the body
            is empty. This plugin returns the RestResponse so AppBootstrap calls sendResponse() (renders the
            JSON error + status). (OPENGENTO_UPSTREAM_CHANGES.md "Change 2".)
        -->
        <plugin name="mage_os_worker_mode_rest_response_fallback"
                type="MageOS\WorkerMode\Plugin\App\RestResponseFallbackPlugin"
                sortOrder="100"/>
        <!--
            Commit sessions to Redis before the REST response is sent (REST order placement → frontend
            success handoff): the REST worker sets last_order_id in the checkout session, but writeClose()
            only runs in the finally block after sendResponse(). closeSessions() in afterLaunch writes it
            immediately so the frontend success page can read it. webapi_rest only. sortOrder=10000.
        -->
        <plugin name="mage_os_worker_mode_session_commit"
                type="MageOS\WorkerMode\Plugin\App\SessionCommitPlugin"
                sortOrder="10000"/>
    </type>
</config>
